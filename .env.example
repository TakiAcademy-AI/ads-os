DATABASE_URL=postgresql://marketing:devpass@localhost:5434/ads_os
SESSION_PASSWORD=
ADMIN_EMAIL=admin@taki.vn
ADMIN_PASSWORD=Admin@123456
ENCRYPTION_KEY=
FB_API_VERSION=v26.0

# Facebook Login for Business — cần để dùng nút "Đăng nhập bằng Facebook".
# Không có thì giao diện tự chuyển sang luồng dán token thủ công.
FB_APP_ID=
FB_APP_SECRET=
# Để trống thì suy từ origin của request. Chỉ đặt khi chạy sau proxy/domain khác.
FB_REDIRECT_URI=

# Token cho systemd timer gọi /api/cron. Không đặt thì endpoint từ chối hẳn.
CRON_TRIGGER_TOKEN=

# ── Google Ads ───────────────────────────────────────────────────────────────
# Client ID/Secret: Google Cloud Console → APIs & Services → Credentials →
#   OAuth client ID (loại Web application). Redirect URI phải khai đúng:
#   https://<domain>/api/connections/google/callback
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Developer token: KHÔNG CÒN BẮT BUỘC — Google bỏ từ 9/9/2026. Cấp truy cập
# (Test/Explorer/Basic/Standard) giờ gắn với project Google Cloud chứa OAuth
# client: Cloud Console → trang Tổng quan Google Ads API của project. Project
# mới chỉ có Test — chỉ gọi được tài khoản thử nghiệm. Để trống được.
GOOGLE_ADS_DEVELOPER_TOKEN=
# Để trống thì tự suy ra từ origin.
GOOGLE_ADS_REDIRECT_URI=
# v21 đã bị Google khai tử. Lịch: developers.google.com/google-ads/api/docs/sunset-dates
GOOGLE_ADS_API_VERSION=v25
